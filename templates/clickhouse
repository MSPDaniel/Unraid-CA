<?xml version="1.0"?>
<Container version="2">
  <Name>clickhouse</Name>
  <Repository>clickhouse/clickhouse-server:latest</Repository>
  <Registry>https://github.com/ClickHouse/ClickHouse</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview> If used with Plausible Analytics the "plausible_events_db" should be created throuth terminal after the container starts using the following command: &#13;
&#13;
docker exec -it clickhouse clickhouse-client&#13;
&#13;
CREATE DATABASE IF NOT EXISTS plausible_events_db&#13;
&#13;
SHOW DATABASES</Overview>
  <WebUI>http://[IP]:[PORT:8123]/play</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/MSPDaniel/Unraid-CA/main/templates/scramble.xml</TemplateURL>
  <DonateText>Find my work useful? Donations are appreciated!</DonateText>
  <DonateLink>https://s.ariskin.cc/donate</DonateLink>
  <Icon>https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/clickhouse.png</Icon>
  <Config Name="Host Port" Target="8123" Default="8123" Mode="tcp" Description="HTTP Port" Type="Port" Display="always" Required="true" Mask="false">8123</Config>
  <Config Name="Data Path" Target="/var/lib/clickhouse" Default="/mnt/user/appdata/clickhouse" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/clickhouse</Config>
  <Config Name="CLICKHOUSE_USER" Target="CLICKHOUSE_USER" Default="default" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">default</Config>
  <Config Name="CLICKHOUSE_PASSWORD" Target="CLICKHOUSE_PASSWORD" Default="" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="User Profiles Override" Target="/etc/clickhouse-server/users.d" Default="/mnt/user/appdata/clickhouse/users.d" Mode="rw" Description="" Type="Path" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Server Profiles Override:" Target="/etc/clickhouse-server/conf.d" Default="/mnt/user/appdata/clickhouse/conf.d" Mode="rw" Description="" Type="Path" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Log Directory" Target="/var/log/clickhouse-server/" Default="/mnt/user/appdata/clickhouse/logs" Mode="rw" Description="Clickhouse log directory." Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/clickhouse/logs</Config>
  <TailscaleStateDir/>
</Container>
